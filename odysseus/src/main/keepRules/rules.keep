# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# This is a client library: its public API is only ever called from consuming apps, never from
# within the library itself, so R8 has no way to know it's "used". Keep it fully intact - not
# stripped and not renamed - both when this module minifies itself and (via the same file, bundled
# as a consumer rule into the AAR) when a downstream app minifies against it.
-keep public class pl.codetitans.odyssesus.** {
    public *;
    protected *;
}